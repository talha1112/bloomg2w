rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ===============================================================
    // profile_photos/{uid}.jpg — member profile photos
    // ===============================================================
    // Previously `allow read: if true` (public, unauthenticated). This
    // program serves girls aged 8–17; their profile photos must not be
    // publicly readable. Changed to require sign-in. Every screen that
    // displays a profile photo already requires the viewer to be signed
    // in, so this does not break any existing flow.
    match /profile_photos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ===============================================================
    // speaker_photos/{uid}.jpg — Guest Speaker application headshots
    // ===============================================================
    // Split out from profile_photos so a speaker's application photo can
    // never collide with (and silently overwrite) their own member
    // profile photo or a partner's logo — previously all three shared the
    // single path profile_photos/{uid}.jpg.
    match /speaker_photos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ===============================================================
    // partner_logos/{uid}.jpg — Community Partner business logos
    // ===============================================================
    // Split out from profile_photos for the same reason as speaker_photos.
    // Partner logos are shown in the public Community Partners directory,
    // so (unlike the two collections above) authenticated read access is
    // sufficient — the directory itself already requires sign-in to view.
    match /partner_logos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
