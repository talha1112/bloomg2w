# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Node (Cloud Functions and QA test harness)
node_modules/
npm-debug.log*
functions/lib/

# Local secrets — never commit real credentials. Emulator-only dummy
# secrets belong in *.local files, which are also ignored here.
*.local
.env
.env.*
functions/.runtimeconfig.json
**/serviceAccountKey*.json

# Firebase Local Emulator Suite
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
database-debug.log
pubsub-debug.log

# Build output artifacts (APK/AAB) — regenerate via flutter build, don't commit
play_store_assets/*.apk
play_store_assets/*.aab

# Claude Code local session state
.claude/
